# Core
ANTHROPIC_API_KEY=

# Optional: caveman-style terse replies (https://github.com/JuliusBrussee/caveman). Same as pasting their system-prompt snippet.
# off | lite | full | ultra | wenyan-lite | wenyan-full | wenyan-ultra | true (= full)
# Per-user override in chat: first line `/caveman full`, `stop caveman`, `caveman reset` (see src/agent/caveman.ts).
COMPANIO_CAVEMAN=wenyan-ultra

# Optional: Claude Agent SDK built-ins (default none)
# none | read (Read,Glob,Grep) | full (full claude_code preset — Bash, edits, etc.)
COMPANIO_BUILTIN_TOOLS=none
# Headless only: bypass permission prompts (dangerous if strangers can message the bot)
COMPANIO_BYPASS_PERMISSIONS=false

# MongoDB Atlas
# Create an Atlas database user and add your deployment's IP to Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/companio?retryWrites=true&w=majority
# Optional; defaults to "companio". Do not put credentials in this value.
MONGODB_DB=companio

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Slack (Phase 3)
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# ClickUp
CLICKUP_API_KEY=
CLICKUP_FOLDER_ID=
CLICKUP_MEMBER_ID=

# Linear (MCP: https://mcp.linear.app/mcp)
LINEAR_API_KEY=

# GitHub (MCP: @modelcontextprotocol/server-github)
# Fine-grained or classic PAT; mapped to GITHUB_PERSONAL_ACCESS_TOKEN for the server.
# See: https://github.com/settings/tokens
GITHUB_TOKEN=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=

# Webhook (Phase 4)
WEBHOOK_SECRET=
WEBHOOK_PORT=3000

# Workspace tools (Telegram owner only). Compose sets the container root automatically.
# Create /home/seed on the deployment server before starting Compose.
# Optional host override: COMPANIO_WORKSPACE_HOST_PATH=/absolute/path/to/seed
# For running without Docker, opt in with an existing absolute directory:
# COMPANIO_WORKSPACE_ROOT=/absolute/path/to/seed
